{
  "name": "apuracao-2026-sc",
  "private": true,
  "type": "module",
  "description": "Apuração 2026 SC: front-end Vite (sem framework) + API Hono com Drizzle ORM e Postgres no Neon, publicado no Vercel.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"vite\" \"tsx watch server/dev.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/dev.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "node --check app.js && node --check campanha.js && node --check api.js && node --check chances.js && node --check vagas.js && node --check cores.js && node --check icones.js && node --check regioes.js && node --check floripa.js",
    "test": "playwright test",
    "test:gravar": "GRAVAR_TSE=1 playwright test",
    "test:api": "node --import tsx --test server/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@hono/vercel": "^1.0.1",
    "@neondatabase/serverless": "^1.0.1",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.8.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@hono/node-server": "^1.14.4",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.15.32",
    "concurrently": "^9.1.2",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
