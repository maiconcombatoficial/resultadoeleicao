# Copie para .env (não vai para o git). No Vercel, a integração com o Neon cria DATABASE_URL sozinha.
# Banco Postgres no Neon (https://neon.com): string de conexão com ?sslmode=require.
# Sem DATABASE_URL, o desenvolvimento usa um Postgres embutido (PGlite) em .dados-local/ (BANCO_LOCAL=0 desliga).
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Porta da API no desenvolvimento local (npm run dev sobe o Vite em 5173 e a API aqui)
PORT=8787
# Endereço do site (origem do front): links de e-mail, retorno do Google e do pagamento. No Vercel: https://<projeto>.vercel.app
APP_URL=http://localhost:5173

# 🧠 IA (opcional): chave da API da Anthropic; sem ela, só a IA fica desligada. O limite diário vem do plano (server/planos.ts).
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5-5

# Login com Google (opcional): credencial OAuth "Aplicativo da Web" no Google Cloud, com o redirecionamento
# ${APP_URL}/api/auth/google/retorno
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 💳 Mercado Pago (opcional): Access Token da aplicação (TEST-… para testar) e a assinatura secreta dos webhooks
# (URL do webhook: ${APP_URL}/api/cobranca/webhook, eventos "Pagamentos" e "Planos e assinaturas")
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# E-mail (recuperação de senha) pelo Resend; sem a chave, o link sai no console da API
RESEND_API_KEY=
EMAIL_DE="Apuração SC <nao-responda@seudominio.com.br>"

# Chave da área 🔒 Análises (base64), a mesma dos public/pro/*.bin: entregue a quem tem plano com Análises
PRO_CHAVE=
